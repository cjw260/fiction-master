APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173

# All three default providers use Alibaba Cloud Model Studio.
DASHSCOPE_API_KEY=
CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank

FICTION_DIR=fiction
DATA_DIR=data
MAX_FICTION_FILE_MB=100
AUTO_SYNC_ON_STARTUP=true

# Optional LightRAG graph-retrieval sidecar. Keep disabled until the graph
# service is configured and running. Local Python development uses 127.0.0.1;
# Docker Compose overrides this URL to http://lightrag:9621.
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_QUERY_TIMEOUT_SECONDS=10
LIGHTRAG_INDEX_TIMEOUT_SECONDS=180
LIGHTRAG_INDEX_POLL_INTERVAL_SECONDS=2
LIGHTRAG_INDEX_MAX_WAIT_SECONDS=3600
LIGHTRAG_INDEX_BATCH_SIZE=20
LIGHTRAG_REQUEST_RETRIES=5
# 可选：只构建列出的书名；留空表示构建全部小说。
LIGHTRAG_INDEX_BOOK_TITLES=
MAX_ASYNC_LLM=8
MAX_PARALLEL_INSERT=3
EMBEDDING_FUNC_MAX_ASYNC=16
EMBEDDING_BATCH_NUM=10
LIGHTRAG_MODE=mix
LIGHTRAG_TOP_K=10
LIGHTRAG_CHUNK_TOP_K=12
LIGHTRAG_MAX_ENTITY_TOKENS=2500
LIGHTRAG_MAX_RELATION_TOKENS=3500
LIGHTRAG_MAX_TOTAL_TOKENS=8000
LIGHTRAG_ENABLE_RERANK=false
LIGHTRAG_EXPANDED_QUERY_LIMIT=3
LIGHTRAG_RRF_WEIGHT=0.7

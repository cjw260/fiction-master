.DS_Store
.env
.env.*
!.env.example

# Runtime data and local model/vector caches
# A verified portable snapshot is committed separately under backups/dataset/.
data/*
!data/.gitkeep

# Live source files are restored from backups/dataset/; keep them out of normal diffs.
fiction/*
!fiction/.gitkeep
!fiction/README.md

# Python
__pycache__/
*.py[cod]
*.ses
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/

# Frontend
node_modules/
front/node_modules/
front/dist/
